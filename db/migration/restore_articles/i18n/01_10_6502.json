data),a call negative jp zeroa oraz call param8 ld h,0:ld l,a call loada jp orac orazx call param8 ld h,0:ld l,a call addx8 call loada jp orac oram call param16 call loada jp orac oramx call param16 call addx16 call loada jp orac oramy call param16 call addy16 call loada jp orac oraix call param8 ld h,0:ld l,a call addx8 call paramind call loada jp orac oraiy call param8 ld h,0:ld l,a call paramind call addy16 call loada jp orac\n\neork call param8 eorc ld b,a ld a,(rega) xor b ld (rega),a ld (data),a call negative jp zeroa eorz call param8 ld h,0:ld l,a call loada jp eorc eorzx call param8 ld h,0:ld l,a call addx8 call loada jp eorc eorm call param16 call loada jp eorc eormx call param16 call addx16 call loada jp eorc eormy call param16 call addy16 call loada jp eorc eorix call param8 ld h,0:ld l,a call addx8 call paramind call loada jp eorc eoriy call param8 ld h,0:ld l,a call paramind call addy16 call loada jp eorc\n\nrola ld a,(rega) ld b,a call rolb ld (rega),a\n\nrolb call tstc jr nz,rolacs scf ccf jp rolac rolacs scf rolac ld a,b rla ld b,a call carry ld a,b:ret\n\nrolz call param8 ld h,0:ld l,a rolzc ld (adr),hl call loada ld b,a:call rolb ld hl,(adr) call storea ret\n\nrolzx call param8 ld h,0:ld l,a call addx8 jp rolzc\n\nrolm call param16 jp rolzc\n\nrolmx call param16 call addx16 jp rolzc\n\nrora ld a,(rega) ld b,a call rorb ld (rega),a\n\nrorb call tstc jr nz,roracs scf ccf jp rorac roracs scf rorac ld a,b rra ld b,a call carry ld a,b:ret\n\nrorz call param8 ld h,0:ld l,a rorzc ld (adr),hl call loada ld b,a:call rorb ld hl,(adr) call storea ret\n\nrorzx call param8 ld h,0:ld l,a call addx8 jp rorzc\n\nrorm call param16 jp rorzc\n\nrormx call param16 call addx16 jp rorzc\n\nclc jp resc sec jp setc cld jp resd sed jp setd cli jp resi sei jp seti clv jp resv\n\ncmpk call param8 cmpc ld b,a ld a,(rega) cmpr sub b ld (data),a ccf call carry call negativea jp zeroa\n\ncmpz call param8 ld h,0:ld l,a call loada jp cmpc\n\ncmpzx call param8 ld h,0:ld l,a call addx8 call loada jp cmpc\n\ncmpm call param16 call loada jp cmpc cmpmx call param16 call addx16 call loada jp cmpc cmpmy call param16 call addy16 call loada jp cmpc cmpix call param8 ld h,0:ld l,a call addx8 call paramind call loada jp cmpc cmpiy call param8 ld h,0:ld l,a call paramind call addy16 call loada jp cmpc\n\ncpxk call param8 ld b,a ld a,(regx) jp cmpr cpxz call param8 ld h,0:ld l,a call loada ld b,a ld a,(regx) jp cmpr cpxm call param16 call loada ld b,a ld a,(regx) jp cmpr cpyk call param8 ld b,a ld a,(regy) jp cmpr cpyz call param8 ld h,0:ld l,a call loada ld b,a ld a,(regy) jp cmpr cpym call param16 call loada ld b,a ld a,(regy) jp cmpr\n\nbitz call param8 ld h,0:ld l,a bitcomm call loada ld (data),a and %01000000 jr z,bitcorv call setv bitcov call negativea ld a,(rega) and (data) jp zero bitcorv call resv:jp bitcov\n\nbitm call param16 jp bitcomm\n\n������������������������������� � END OF CORE INSTRUCTION SET � �������������������������������\n\nNČsledujď rutiny pro naŽďtČnď parametr� za instrukcď, rutiny pro zpracovČnď nep�ďm�ch a indexovan�ch parametr� - p�iŽtenď osmibitováho nebo 16bitováho Žďsla k emulovanámu X nebo Y registru.\n\nparam ld hl,(regpc) inc hl ld (regpc),hl ret param8 call param call loada ret param16 call param call loada ld (adr),a call param call loada ld (adr+1),a ld hl,(adr) ret paramind push hl call loada ld (adr),a pop hl:inc hl call loada ld (adr+1),a ld hl,(adr) ret addx8 ld a,(regx) add a,l:ld l,a ret addx16 ld a,(regx) ld e,a:ld d,0 add hl,de:ret addy8 ld a,(regy) add a,l:ld l,a ret addy16 ld a,(regy) ld e,a:ld d,0 add hl,de:ret\n\nZde je pak prostor, kde jsou ulo�eny emulovaná registry. Osmibitov� stack REGS je roz�ď�en na 16bitov� registr REGSP. Je p�ednastaven registr REGPC a flagy REGP na v�chozď hodnoty, ostatnď registry jsou nulová.\n\nPotom nČsledujď rutiny pro prČci s flagy. ADDR a DATA jsou dvô doŽasnČ úlo�i�tô 16bitová a 8bitová hodnoty.\n\n������������������ � 6502 REGISTERS � ������������������ rega nop regx nop regy nop regp db %00100010 regsp regs nop db 1 regpc dw #ff00\n\nnegativea ld a,(data) negative and %10000000 jr z,resn jp setn\n\ncarry jr c,setc jp resc\n\nflow jp po,resv jp setv\n\nzeroa ld a,(data) zero or a jr z,setz jp resz\n\nsetc ld d,%1 jp setcom setz ld d,%10 jp setcom seti ld d,%100 jp setcom setd ld d,%1000 jp setcom setb ld d,%10000 jp setcom setv ld d,%1000000 jp setcom setn ld d,%10000000 setcom ld a,(regp) or d ld (regp),a ret resc ld d,%11111110 jp rescom resz ld d,%11111101 jp rescom resi ld d,%11111011 jp rescom resd ld d,%11110111 jp rescom resb ld d,%11101111 jp rescom resv ld d,%10111111 jp rescom resn ld d,%01111111 rescom ld a,(regp) and d ld (regp),a ret tstz ld d,%00000010 jp tstcom tstn ld d,%10000000 jp tstcom tstc ld d,%00000001 jp tstcom tstd ld d,%00001000 jp tstcom tstv ld d,%01000000 tstcom ld a,(regp) and d ret\n\nadr nop:nop data nop\n\nNČsleduje tabulka instrukcď. Jako jedinČ je zarovnanČ na 256bajtovou \"strČnku\" a obsahuje prostô jen 16bitová adresy rutin pro vykonČnď instrukcď �azen�ch vzestupnô. Nedokumentovaná instrukce nejsou emulovČny, jejich kÓd je oznaŽen ILG.\n\n������������������� � �� � T A B L E S �� � �� �������������������� ������������������� org $/256+1*256\n\ntable dw brk,oraix,ilg,ilg dw ilg,oraz,aslz,ilg dw php,orak,asla,ilg dw ilg,oram,aslm,ilg\n\ndw bpl,oraiy,ilg,ilg dw ilg,orazx,aslzx,ilg dw clc,oramy,ilg,ilg dw ilg,oramx,aslmx,ilg\n\ndw jsr,andix,ilg,ilg dw bitz,andz,rolz,ilg dw plp,andk,rola,ilg dw bitm,andm,rolm,ilg\n\ndw bmi,andiy,ilg,ilg dw ilg,andzx,rolzx,ilg dw sec,andmy,ilg,ilg dw ilg,andmx,rolmx,ilg\n\ndw rti,eorix,ilg,ilg dw ilg,eorz,lsrz,ilg dw pha,eork,lsra,ilg dw jmpk,eorm,lsrm,ilg\n\ndw bvc,eoriy,ilg,ilg dw ilg,eorzx,lsrzx,ilg dw cli,eormy,ilg,ilg dw ilg,eormx,lsrmx,ilg\n\ndw rts,adcix,ilg,ilg dw ilg,adcz,rorz,ilg dw pla,adck,rora,ilg dw jmpm,adcm,rorm,ilg\n\ndw bvs,adciy,ilg,ilg dw ilg,adczx,rorzx,ilg dw sei,adcmy,ilg,ilg dw ilg,adcmx,rormx,ilg\n\ndw ilg,staix,ilg,ilg dw styz,staz,stxz,ilg dw dey,ilg,txa,ilg dw stym,stam,stxm,ilg\n\ndw bcc,staiy,ilg,ilg dw styzx,stazx,stxzy,ilg dw tya,stamy,txs,ilg dw ilg,stamx,ilg,ilg\n\ndw ldyk,ldaix,ldxk,ilg dw ldyz,ldaz,ldxz,ilg dw tay,ldak,tax,ilg dw ldym,ldam,ldxm,ilg\n\ndw bcs,ldaiy,ilg,ilg dw ldyzx,ldazx,ldxzy,ilg dw clv,ldamy,tsx,ilg dw ldymx,ldamx,ldxmy,ilg\n\ndw cpyk,cmpix,ilg,ilg dw cpyz,cmpz,decz,ilg dw iny,cmpk,dex,ilg dw cpym,cmpm,decm,ilg\n\ndw bne,cmpiy,ilg,ilg dw ilg,cmpzx,deczx,ilg dw cld,cmpmy,ilg,ilg dw ilg,cmpmx,decmx,ilg\n\ndw cpxk,sbcix,ilg,ilg dw cpxz,sbcz,incz,ilg dw inx,sbck,noop,ilg dw cpxm,sbcm,incm,ilg\n\ndw beq,sbciy,ilg,ilg dw ilg,sbczx,inczx,ilg dw sed,sbcmy,ilg,ilg dw ilg,sbcmx,incmx,ilg\n",
  "body_ru": "Привет, спектрумисты,\n\nВы читаете очередной номер дискмагазина Restore и, наверное, удивляетесь, что общего у него с трёхрегистровым процессором 6502. Когда-то в 2004 году я сделал эмулятор Apple I для ZX Spectrum. Частью этого эмулятора были и дизассемблер, и простой ассемблер кода для процессора 6502. О нём я написал серию статей ещё в 2005 году. А что насчёт самого ядра эмулятора? Код и исходник открыты. Если поймёте его так, что сможете использовать в собственной программе, — пользуйтесь: ничто и никто вам в этом не мешает.\n\nПочти двадцать лет, однако, ушло на то, чтобы достать исходник со старого ноутбука. Он был написан в русском ассемблере ZXASM 3.0 для Betadisk в эмуляторе X128 под MS-DOS.\n\nТеперь у нас есть исходник в человекочитаемом виде — правда, как у меня было принято с Prometheus, комментариями я особо не баловался, и понять его было бы, пожалуй, трудновато. Поэтому снабжаю его поясняющим текстом.\n\nБольшая часть кода не зависит от hardware, так что эмулятор сравнительно легко переносим на разные Z80-платформы. От hardware зависит менеджер отдельных эмулируемых процессорных циклов. А именно: после вызова выполнения одного процессорного цикла (CALL INSTRUCTION) он читает клавиатуру, прыгает в меню, эмулирует нажатие аппаратных кнопок — RESET, а у Apple I ещё и аппаратную очистку экрана. Также при необходимости вызывает вывод содержимого регистров и обслуживает его включение или выключение. Вызывает внешнюю рутину INKEY, которая читает клавиатуру, и рутины в модуле MONITOR, который содержит главное меню эмулятора с уже упомянутыми ассемблером и дизассемблером. Содержит и рутину MONITOR для вывода содержимого регистров. Та начинается перезаписываемой инструкцией — либо RET, когда вывод регистров не выполняется, либо NOP, когда рутина вывода исполняется.\n\n========================\n| 6502 Virtual Machine |\n========================\n; CYCLE MANAGER * HW dependent\n; INSTR. CYCLE * HW independent\n; 6502 CORE * HW independent\n; REGISTERS * HW independent\n\n======================\n| 6502 CYCLE MANAGER |\n======================\n;** HW dependent ** ;uses keyboard ;uses monitor\ncycle call instruction\n\ncall inkey or a:jp z,nomkey cp 8:jr z,oneinstr cp 9:jr z,cycleinstr cp 15:jr z,hwclrscr cp 7:jp z,reset cp 4:jr z,monitoroff cp 5:jr z,monitoron cp 10:jp z,menudown cp 11:jp z,menuup cp 6:call z,caps nomkey retmonitor call monitor ld a,(iy+48):ld (23232),a ;CAPS jp cycle\n\nmonitoron xor a:ld (monitor),a ld hl,23264:ld de,23265 ld (hl),%001111:ld bc,31:ldir jr retmonitor monitoroff ld a,201:ld (monitor),a ld hl,23264:ld de,23265 ld (hl),%001001:ld bc,31:ldir jr retmonitor hwclrscr res 5,(iy+1) call clearscreen jr retmonitor\n\noneinstr ld a,201:ld (instruction),a res 5,(iy+1) call step jp monitoron cycleinstr xor a:ld (instruction),a res 5,(iy+1) jp retmonitor\n\nТеперь мы в части, которая сама по себе была аппаратно независимой, но вызывает две внешние аппаратно зависимые рутины, которые я ещё подробнее опишу. К тому же я уже начал не вполне системно добавлять в неё рутины, хоть и независимые от hardware, но специфичные для данного эмулируемого компьютера: по адресам C170, C18D и C163 находятся входы в рутины обслуживания магнитофона на Apple I. То есть если эмулируемый регистр PC содержит значения C170, C18D или C163, выполняются переходы на рутины TAPEW для записи, TAPER для чтения, а TAPEEOL — выходная точка.\n\nПервая инструкция обработки инструционного цикла — NOP или RET. Эту инструкцию меняет уже описанный менеджер процессорных циклов. Если здесь NOP, эмулируемые процессорные циклы выполняются нормально. Если здесь RET, ничего не выполняется: эмулируемый процессор стоит, и менеджер лишь читает управляющие клавиши. Вызовом с адреса STEP каждый раз выполняется эмуляция одной инструкции.\n\nВ первой части — декодирование инструкции: если не выполняется код из ROM кассетного интерфейса, с адреса, заданного эмулируемым регистром PC, читается код инструкции, и в таблице TABLE ищется адрес, по которому лежит рутина выполнения инструкции с прочитанным кодом.\n\n=====================\n| 6502 INSTR. CYCLE |\n=====================\n;** HW independent **\n;uses memory manager\n\ninstruction nop ;RET disables run step ld a,(regpc+1):cp #c1 call z,tapepoints call step1 jp param ;inc PC step1 ld hl,(regpc):call loada ld de,table:ld h,0:ld l,a add hl,hl add hl,de ld a,(hl):ld (jump+1),a inc hl:ld a,(hl):ld (jump+2),a jump jp 0\n\ntapepoints ld a,(regpc) cp #70:jp z,tapew cp #8d:jp z,taper cp #63:jp z,tapeeol ret\n\nПора упомянуть о рутинах LOADA и STOREA, которые, по сути, служат эмулируемому процессору для общения с окружающим миром. Обе аппаратно зависимы и не входят в эту распечатку. В чём суть? Они обслуживают виртуальное адресное пространство эмулируемого процессора 6502. У него нет разделённых портов и памяти: по сути все периферии «отображены в память» в общем 64 КиБ пространстве.\n\nОбрабатываемый адрес — в регистре HL процессора Z80, записываемое или прочитанное значение — в аккумуляторе A процессора Z80. LOADA и STOREA могут быть, в зависимости от сложности hardware эмулируемого компьютера, довольно комплексными. Они обеспечивают перевод адресов 6502 в адреса Z80, при необходимости — страничание памяти в случае ZX Spectrum 128 (например, мой эмулятор Apple I на ZX 48 эмулирует 16 КиБ RAM, тогда как на ZX 128 с помощью страничания — 32 КиБ RAM). И точно так же обеспечивают связь с периферией (чтение клавиатуры, обслуживание регистров разных чипов — графических, звуковых, ...). Поскольку у Apple I нет VideoRAM, а общение с дисплеем идёт через порт терминала, мой эмулятор не решал эмуляцию графического чипа и вычитку VideoRAM — только запись на терминал.\n\nА теперь наступает само аппаратно независимое ядро; оно само использует только рутины LOADA и STOREA.\n\n«Нелегальные» инструкции и NOP ничего не делают — даже задержки: я рассчитывал, что сама эмуляция будет настолько медленной, что ничего такого не понадобится.\n\nНазвания по большей части понятно указывают, какая инструкция обрабатывается в данной рутине. Вызовы рутин PARAM8 и PARAM16 вызывают чтение восьмибитного или 16-битного параметра инструкции.\n\nНачнём с инструкций загрузки регистров.\n\n=================\n| 6502 CORE |\n=================\nilg noop ret\n\ntax ld a,(rega) t_x ld (regx),a ld (data),a call negative jp zeroa\n\ntay ld a,(rega) t_y ld (regy),a ld (data),a call negative jp zeroa\n\ntxa ld a,(regx) t_a ld (rega),a ld (data),a call negative jp zeroa\n\ntya ld a,(regy) jp t_a\n\ntsx ld a,(regs) jp t_x\n\ntxs ld a,(regx) ld (regs),a ret\n\nldak call param8 jp t_a\n\nldam call param16 call loada jp t_a\n\nldamx call param16 call addx16 call loada jp t_a ldamy call param16 call addy16 call loada jp t_a\n\nldaz call param8 ld l,a:ld h,0:call loada jp t_a\n\nldazx call param8 ld l,a:ld h,0 call addx8 call loada jp t_a\n\nldaix call param8 ld l,a:ld h,0 call addx8 call paramind call loada jp t_a\n\nldaiy call param8 ld l,a:ld h,0 call paramind call addy16 call loada jp t_a\n\nldxk call param8 jp t_x\n\nldxm call param16 call loada jp t_x\n\nldxmy call param16 call addy16 call loada jp t_x\n\nldxz call param8 ld l,a:ld h,0:call loada jp t_x\n\nldxzy call param8 ld l,a:ld h,0 call addy8 call loada jp t_x\n\nldyk call param8 jp t_y\n\nldym call param16 call loada jp t_y\n\nldymx call param16 call addx16 call loada jp t_y\n\nldyz call param8 ld l,a:ld h,0:call loada jp t_y\n\nldyzx call param8 ld l,a:ld h,0 call addx8 call loada jp t_y\n\nstam call param16 ld a,(rega) call storea ret\n\nstamx call param16 call addx16 ld a,(rega) call storea ret\n\nstamy call param16 call addy16 ld a,(rega) call storea ret\n\nstaz call param8 ld l,a:ld h,0:ld a,(rega) call storea ret\n\nstazx call param8 ld l,a:ld h,0 call addx8 ld a,(rega) call storea ret\n\nstaix call param8 ld l,a:ld h,0 call addx8 call paramind ld a,(rega) call storea ret\n\nstaiy call param8 ld l,a:ld h,0 call paramind call addy16 ld a,(rega) call storea ret\n\nstxm call param16 ld a,(regx) call storea ret\n\nstxz call param8 ld l,a:ld h,0:ld a,(regx) call storea ret\n\nstxzy call param8 ld l,a:ld h,0 call addy8 ld a,(regx) call storea ret\n\nstym call param16 ld a,(regy) call storea ret\n\nstyz call param8 ld l,a:ld h,0:ld a,(regy) call storea ret\n\nstyzx call param8 ld l,a:ld h,0 call addx8 ld a,(regy) call storea ret\n\npha ld a,(rega) ld hl,(regsp) ld (data),a call storea call pushni call negativea:jp zeroa\n\nphp ld a,(regp) ld hl,(regsp) call storea call pushni ret\n\npla call popni ld hl,(regsp) call loada ld (rega),a ld (data),a call negativea:jp zeroa\n\nplp call popni ld hl,(regsp) call loada ld (regp),a ret\n\npushni ld a,(regs):dec a ld (regs),a:ret popni ld a,(regs):inc a ld (regs),a:ret\n\njmpk call param16 dec hl ld (regpc),hl ret\n\njmpm call param16 push hl call loada ld (adr),a pop hl inc hl call loada ld (adr+1),a ld hl,(adr) dec hl ld (regpc),hl ret\n\njsr call param16 ld a,(regpc+1) ld hl,(regsp) call storea call pushni ld a,(regpc) ld hl,(regsp) call storea call pushni ld hl,(adr) dec hl ld (regpc),hl ret\n\nrts call popni ld hl,(regsp) call loada ld (regpc),a call popni ld hl,(regsp) call loada ld (regpc+1),a ret\n\nbrk call param ld a,(regpc+1) ld hl,(regsp) call storea call pushni ld a,(regpc) ld hl,(regsp) call storea call pushni call php ld hl,#fffe call loada ld (adr),a ld hl,#ffff call loada ld (adr+1),a ld hl,(adr) ld (regpc),hl call setb ret\n\nrti call plp jp rts\n\nbeq call param8 ld (relparam),a call tstz ret z relcom ld a,(relparam) bit 7,a jr nz,relback relfwd ld hl,(regpc) ld e,a ld d,0 add hl,de ld (regpc),hl ret relback xor #ff ld hl,(regpc) ld e,a ld d,0 scf sbc hl,de ld (regpc),hl ret relparam nop\n\nbne call param8 ld (relparam),a call tstz ret nz jp relcom\n\nbmi call param8 ld (relparam),a call tstn ret z jp relcom\n\nbpl call param8 ld (relparam),a call tstn ret nz jp relcom\n\nbcs call param8 ld (relparam),a call tstc ret z jp relcom\n\nbcc call param8 ld (relparam),a call tstc ret nz jp relcom\n\nbvs call param8 ld (relparam),a call tstv ret z jp relcom\n\nbvc call param8 ld (relparam),a call tstv ret nz jp relcom\n\nadck call param8 adccom ld (data),a call tstd jp z,adcnd ld a,39:ld (adcdec),a ;DAA adcnd call tstc ld a,(data) ld b,a jr z,adcnocarry scf:jp adcc adcnocarry scf:ccf adcc ld a,(rega) adc a,b adcdec nop ld (rega),a push af call carry pop af call flow ld a,(rega):call negative ld a,(rega):call zero xor a:ld (adcdec),a:ret\n\nadcm call param16 call loada jp adccom adcmx call param16 call addx16 call loada jp adccom adcmy call param16 call addy16 call loada jp adccom adcz call param8 ld l,a:ld h,0:call loada jp adccom adczx call param8 ld l,a:ld h,0 call addx8 call loada jp adccom adcix call param8 ld l,a:ld h,0 call addx8 call paramind call loada jp adccom adciy call param8 ld l,a:ld h,0 call paramind call addy16 call loada jp adccom\n\nsbck call param8 sbccom ld (data),a call tstd jp z,sbcnd ld a,39:ld (sbcdec),a ;DAA sbcnd ld a,(data):ld b,a call tstc jr z,sbcnocarry scf:ccf:jp sbcc ;~CARRY sbcnocarry scf ;~CARRY sbcc ld a,(rega) sbc a,b sbcdec nop push af ld (rega),a ccf call carry pop af call flow ld a,(rega):call negative ld a,(rega):call zero xor a:ld (sbcdec),a:ret\n\nsbcm call param16 call loada jp sbccom sbcmx call param16 call addx16 call loada jp sbccom sbcmy call param16 call addy16 call loada jp sbccom sbcz call param8 ld l,a:ld h,0:call loada jp sbccom sbczx call param8 ld l,a:ld h,0 call addx8 call loada jp sbccom sbcix call param8 ld l,a:ld h,0 call addx8 call paramind call loada jp sbccom sbciy call param8 ld l,a:ld h,0 call paramind call addy16 call loada jp sbccom\n\nincz call param8 ld h,0:ld l,a incc ld (adr),hl call loada inc a ld (data),a ld hl,(adr) call storea call negativea jp zeroa inczx call param8 ld h,0:ld l,a call addx8 jp incc incm call param16 jp incc incmx call param16 call addx16 jp incc\n\ninx ld a,(regx) inc a ld (regx),a ld (data),a call negative jp zeroa\n\niny ld a,(regy) inc a ld (regy),a ld (data),a call negative jp zeroa\n\ndecz call param8 ld h,0:ld l,a decc ld (adr),hl call loada dec a ld (data),a ld hl,(adr) call storea call negativea jp zeroa deczx call param8 ld h,0:ld l,a call addx8 jp decc decm call param16 jp decc decmx call param16 call addx16 jp decc\n\ndex ld a,(regx) dec a ld (regx),a ld (data),a call negative jp zeroa\n\ndey ld a,(regy) dec a ld (regy),a ld (data),a call negative jp zeroa\n\nasla ld a,(rega) sla a ld (data),a call carry ld a,(data) ld (rega),a call negative jp zeroa\n\naslz call param8 ld h,0:ld l,a ld (adr),hl call loada sla a ld (data),a call carry ld a,(data) ld hl,(adr) call storea call negativea jp zeroa\n\naslzx call param8 ld h,0:ld l,a call addx8 ld (adr),hl call loada sla a ld (data),a call carry ld a,(data) ld hl,(adr) call storea call negativea jp zeroa\n\naslm call param16 ld (adr),hl call loada sla a ld (data),a call carry ld a,(data) ld hl,(adr) call storea call negativea jp zeroa\n\naslmx call param16 call addx16 ld (adr),hl call loada sla a ld (data),a call carry ld a,(data) ld hl,(adr) call storea call negativea jp zeroa\n\nlsra ld a,(rega) srl a ld (data),a call carry ld a,(data) ld (rega),a call negative jp zeroa\n\nlsrz call param8 ld h,0:ld l,a ld (adr),hl call loada srl a ld (data),a call carry ld a,(data) ld hl,(adr) call storea call negativea jp zeroa\n\nlsrzx call param8 ld h,0:ld l,a call addx8 ld (adr),hl call loada srl a ld (data),a call carry ld a,(data) ld hl,(adr) call storea call negativea jp zeroa\n\nlsrm call param16 ld (adr),hl call loada srl a ld (data),a call carry ld a,(data) ld hl,(adr) call storea call negativea jp zeroa\n\nlsrmx call param16 call addx16 ld (adr),hl call loada srl a ld (data),a call carry ld a,(data) ld hl,(adr) call storea call negativea jp zeroa\n\nandk call param8 andc ld b,a ld a,(rega) and b ld (rega),a ld (data),a call negative jp zeroa andz call param8 ld h,0:ld l,a call loada jp andc andzx call param8 ld h,0:ld l,a call addx8 call loada jp andc andm call param16 call loada jp andc andmx call param16 call addx16 call loada jp andc andmy call param16 call addy16 call loada jp andc andix call param8 ld h,0:ld l,a call addx8 call paramind call loada jp andc andiy call param8 ld h,0:ld l,a call paramind call addy16 call loada jp andc\n\norak call param8 orac ld b,a ld a,(rega) or b ld (rega),a ld (data),a call negative jp zeroa oraz call param8 ld h,0:ld l,a call loada jp orac orazx call param8 ld h,0:ld l,a call addx8 call loada jp orac oram call param16 call loada jp orac oramx call param16 call addx16 call loada jp orac oramy call param16 call addy16 call loada jp orac oraix call param8 ld h,0:ld l,a call addx8 call paramind call loada jp orac oraiy call param8 ld h,0:ld l,a call paramind call addy16 call loada jp orac\n\neork call param8 eorc ld b,a ld a,(rega) xor b ld (rega),a ld (data),a call negative jp zeroa eorz call param8 ld h,0:ld l,a call loada jp eorc eorzx call param8 ld h,0:ld l,a call addx8 call loada jp eorc eorm call param16 call loada jp eorc eormx call param16 call addx16 call loada jp eorc eormy call param16 call addy16 call loada jp eorc eorix call param8 ld h,0:ld l,a call addx8 call paramind call loada jp eorc eoriy call param8 ld h,0:ld l,a call paramind call addy16 call loada jp eorc\n\nrola ld a,(rega) ld b,a call rolb ld (rega),a\n\nrolb call tstc jr nz,rolacs scf ccf jp rolac rolacs scf rolac ld a,b rla ld b,a call carry ld a,b:ret\n\nrolz call param8 ld h,0:ld l,a rolzc ld (adr),hl call loada ld b,a:call rolb ld hl,(adr) call storea ret\n\nrolzx call param8 ld h,0:ld l,a call addx8 jp rolzc\n\nrolm call param16 jp rolzc\n\nrolmx call param16 call addx16 jp rolzc\n\nrora ld a,(rega) ld b,a call rorb ld (rega),a\n\nrorb call tstc jr nz,roracs scf ccf jp rorac roracs scf rorac ld a,b rra ld b,a call carry ld a,b:ret\n\nrorz call param8 ld h,0:ld l,a rorzc ld (adr),hl call loada ld b,a:call rorb ld hl,(adr) call storea ret\n\nrorzx call param8 ld h,0:ld l,a call addx8 jp rorzc\n\nrorm call param16 jp rorzc\n\nrormx call param16 call addx16 jp rorzc\n\nclc jp resc sec jp setc cld jp resd sed jp setd cli jp resi sei jp seti clv jp resv\n\ncmpk call param8 cmpc ld b,a ld a,(rega) cmpr sub b ld (data),a ccf call carry call negativea jp zeroa\n\ncmpz call param8 ld h,0:ld l,a call loada jp cmpc\n\ncmpzx call param8 ld h,0:ld l,a call addx8 call loada jp cmpc\n\ncmpm call param16 call loada jp cmpc cmpmx call param16 call addx16 call loada jp cmpc cmpmy call param16 call addy16 call loada jp cmpc cmpix call param8 ld h,0:ld l,a call addx8 call paramind call loada jp cmpc cmpiy call param8 ld h,0:ld l,a call paramind call addy16 call loada jp cmpc\n\ncpxk call param8 ld b,a ld a,(regx) jp cmpr cpxz call param8 ld h,0:ld l,a call loada ld b,a ld a,(regx) jp cmpr cpxm call param16 call loada ld b,a ld a,(regx) jp cmpr cpyk call param8 ld b,a ld a,(regy) jp cmpr cpyz call param8 ld h,0:ld l,a call loada ld b,a ld a,(regy) jp cmpr cpym call param16 call loada ld b,a ld a,(regy) jp cmpr\n\nbitz call param8 ld h,0:ld l,a bitcomm call loada ld (data),a and %01000000 jr z,bitcorv call setv bitcov call negativea ld a,(rega) and (data) jp zero bitcorv call resv:jp bitcov\n\nbitm call param16 jp bitcomm\n\n\n===============================\n| END OF CORE INSTRUCTION SET |\n===============================\n\nСледуют рутины для считывания параметров за инструкцией, рутины для обработки косвенных и индексных параметров — прибавление восьмибитного или 16-битного числа к эмулируемому регистру X или Y.\n\nparam ld hl,(regpc) inc hl ld (regpc),hl ret param8 call param call loada ret param16 call param call loada ld (adr),a call param call loada ld (adr+1),a ld hl,(adr) ret paramind push hl call loada ld (adr),a pop hl:inc hl call loada ld (adr+1),a ld hl,(adr) ret addx8 ld a,(regx) add a,l:ld l,a ret addx16 ld a,(regx) ld e,a:ld d,0 add hl,de:ret addy8 ld a,(regy) add a,l:ld l,a ret addy16 ld a,(regy) ld e,a:ld d,0 add hl,de:ret\n\nЗдесь затем пространство, где хранятся эмулируемые регистры. Восьмибитный стек REGS расширен до 16-битного регистра REGSP. Преднастроены регистр REGPC и флаги REGP на исходные значения, остальные регистры нулевые.\n\nПотом следуют рутины для работы с флагами. ADDR и DATA — два временных хранилища 16-битного и 8-битного значения.\n\n==================\n| 6502 REGISTERS |\n==================\nrega nop regx nop regy nop regp db %00100010 regsp regs nop db 1 regpc dw #ff00\n\nnegativea ld a,(data) negative and %10000000 jr z,resn jp setn\n\ncarry jr c,setc jp resc\n\nflow jp po,resv jp setv\n\nzeroa ld a,(data) zero or a jr z,setz jp resz\n\nsetc ld d,%1 jp setcom setz ld d,%10 jp setcom seti ld d,%100 jp setcom setd ld d,%1000 jp setcom setb ld d,%10000 jp setcom setv ld d,%1000000 jp setcom setn ld d,%10000000 setcom ld a,(regp) or d ld (regp),a ret resc ld d,%11111110 jp rescom resz ld d,%11111101 jp rescom resi ld d,%11111011 jp rescom resd ld d,%11110111 jp rescom resb ld d,%11101111 jp rescom resv ld d,%10111111 jp rescom resn ld d,%01111111 rescom ld a,(regp) and d ld (regp),a ret tstz ld d,%00000010 jp tstcom tstn ld d,%10000000 jp tstcom tstc ld d,%00000001 jp tstcom tstd ld d,%00001000 jp tstcom tstv ld d,%01000000 tstcom ld a,(regp) and d ret\n\nadr nop:nop data nop\n\nСледует таблица инструкций. Как единственная, она выровнена на 256-байтную «страницу» и содержит попросту только 16-битные адреса рутин выполнения инструкций, упорядоченных по возрастанию. Недокументированные инструкции не эмулируются, их код помечен ILG.\n\n===================\n| T A B L E S |\n===================\norg $/256+1*256\n\ntable dw brk,oraix,ilg,ilg dw ilg,oraz,aslz,ilg dw php,orak,asla,ilg dw ilg,oram,aslm,ilg\n\ndw bpl,oraiy,ilg,ilg dw ilg,orazx,aslzx,ilg dw clc,oramy,ilg,ilg dw ilg,oramx,aslmx,ilg\n\ndw jsr,andix,ilg,ilg dw bitz,andz,rolz,ilg dw plp,andk,rola,ilg dw bitm,andm,rolm,ilg\n\ndw bmi,andiy,ilg,ilg dw ilg,andzx,rolzx,ilg dw sec,andmy,ilg,ilg dw ilg,andmx,rolmx,ilg\n\ndw rti,eorix,ilg,ilg dw ilg,eorz,lsrz,ilg dw pha,eork,lsra,ilg dw jmpk,eorm,lsrm,ilg\n\ndw bvc,eoriy,ilg,ilg dw ilg,eorzx,lsrzx,ilg dw cli,eormy,ilg,ilg dw ilg,eormx,lsrmx,ilg\n\ndw rts,adcix,ilg,ilg dw ilg,adcz,rorz,ilg dw pla,adck,rora,ilg dw jmpm,adcm,rorm,ilg\n\ndw bvs,adciy,ilg,ilg dw ilg,adczx,rorzx,ilg dw sei,adcmy,ilg,ilg dw ilg,adcmx,rormx,ilg\n\ndw ilg,staix,ilg,ilg dw styz,staz,stxz,ilg dw dey,ilg,txa,ilg dw stym,stam,stxm,ilg\n\ndw bcc,staiy,ilg,ilg dw styzx,stazx,stxzy,ilg dw tya,stamy,txs,ilg dw ilg,stamx,ilg,ilg\n\ndw ldyk,ldaix,ldxk,ilg dw ldyz,ldaz,ldxz,ilg dw tay,ldak,tax,ilg dw ldym,ldam,ldxm,ilg\n\ndw bcs,ldaiy,ilg,ilg dw ldyzx,ldazx,ldxzy,ilg dw clv,ldamy,tsx,ilg dw ldymx,ldamx,ldxmy,ilg\n\ndw cpyk,cmpix,ilg,ilg dw cpyz,cmpz,decz,ilg dw iny,cmpk,dex,ilg dw cpym,cmpm,decm,ilg\n\ndw bne,cmpiy,ilg,ilg dw ilg,cmpzx,deczx,ilg dw cld,cmpmy,ilg,ilg dw ilg,cmpmx,decmx,ilg\n\ndw cpxk,sbcix,ilg,ilg dw cpxz,sbcz,incz,ilg dw inx,sbck,noop,ilg dw cpxm,sbcm,incm,ilg\n\ndw beq,sbciy,ilg,ilg dw ilg,sbczx,inczx,ilg dw sed,sbcmy,ilg,ilg dw ilg,sbcmx,incmx,ilg\n",
