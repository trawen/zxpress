RewriteRule ^zxnet/([a-z_\.0-9]+)/([a-z0-9-]+)/?$ zxnet.php?e=$1&id=$2
RewriteRule ^zxnet/?$ zxnet.php
RewriteRule ^menu/([0-9]+)/?$ menu.php?r=$1
RewriteRule ^menu/([0-9]+)/([0-9]+)?$ menu.php?r=$1&id=$2
RewriteRule ^news/p([0-9]+)/?$ news.php?p=$1
RewriteRule ^news/?$ news.php
RewriteRule ^news/([0-9]+)-.*?$ news.php?id=$1
