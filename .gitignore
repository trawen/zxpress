.env
.env.e2e
!.env.example
!.env.e2e.example
conf/manticore.conf
conf/zxpress_db.mysql.*
.cursor
.ai-factory

# Local-only Compose overrides (no Traefik; publish localhost ports)
docker-compose.override.yml

# Personal local processing scripts & work files (keep README tracked)
