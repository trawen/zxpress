site/**/*.7z
site/**/*.tar
site/**/*.tar.gz
site/**/*.tgz
site/**/*.gz
site/**/*.bz2
site/**/*.xz
site/**/*.sna
site/**/*.pt3

site/temp/
site/cat/

# Split storage (uploads / caches / generated indices)
data/
data/**

