!local/work/README.md

# Database data
db/mysql_data/

# Smarty compiled templates
site/smarty/zxpress/templates_c/*
site/smarty/zxpress/cache/*

# Uploaded content (user data, not code)
site/tmp/*

# Large site content/binaries (keep repo clean)
# These are runtime assets/uploads/archives; we don't want them to flood `git status`.
site/chapters_images/
site/image-archive/
site/archive/
site/img/*
!site/img/style.css
!site/img/snailmail-new.css
site/covers/
site/pictures/
site/screens/
site/illustrations/
site/books_files/
site/files/
site/news_files/

site/**/*.png
site/**/*.jpg
site/**/*.jpeg
site/**/*.gif
site/**/*.ico
site/**/*.webp
site/**/*.rar
