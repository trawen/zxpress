# Playwright E2E — copy to e2e/.env.e2e (not committed; loaded by e2e/playwright.config.ts) or set in CI secrets.
# See docs/testing.md

# Canonical acceptance tests target (default in playwright.config.ts if unset):
BASE_URL=https://zxpress.pst-labs.ru
# Local Docker nginx only when you explicitly test the compose stack — not equivalent to staging:
# BASE_URL=http://127.0.0.1:80
# Set to 1 when Docker Compose is already up (CI or ./tools/run-all-tests.sh) — skip Playwright webServer
# PLAYWRIGHT_SKIP_WEBSERVER=1
E2E_ADMIN_USER=admin
E2E_ADMIN_PASS=replace-with-ci-secret-or-local-admin-password
