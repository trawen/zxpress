# =============================================================================
# zxpress.ru — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.

# --- MySQL ---
MYSQL_ROOT_PASSWORD=changeme-root-password
MYSQL_DATABASE=zxpress_db
MYSQL_USER=zxpress_u
MYSQL_PASSWORD=changeme-app-password

# --- PHP Application ---
# Optional: absolute site origin for feeds (RSS Atom links). Overrides Host header when set.
# Example: https://zxpress.ru
# SITE_URL=https://zxpress.ru
# Same role as SITE_URL; use one of them.
# CANONICAL_BASE_URL=https://zxpress.ru
# Comma-separated REMOTE_ADDR values trusted as reverse proxies (suppresses real-IP mismatch logs when X-Forwarded-For is set).
# Example (Traefik): 192.168.202.96
# ZXPRESS_TRUSTED_PROXY_IPS=192.168.202.96
DB_HOST=db
DB_USER=zxpress_u
DB_PASS=changeme-app-password
# Local dev only if DB_PASS must be empty (never in production):
# ALLOW_EMPTY_DB_PASSWORD=1
DB_NAME=zxpress_db
APP_ROOT=/home/zxpress/web/zxpress.ru/public_html
APP_SRC_ROOT=/src-site
SAPE_USER_HASH=df148749a7a956a4334286aea4e556e8

# --- ManticoreSearch ---
MANTICORE_HOST=manticore
MANTICORE_PORT=9308
MANTICORE_SQL_HOST=db
MANTICORE_SQL_PORT=3306
MANTICORE_DB_NAME=zxpress_db
MANTICORE_DB_USER=manticore_ro
MANTICORE_DB_PASS=changeme-manticore-ro-password

# --- Admin session ---
# Idle timeout in seconds (logout after no requests). Default/minimum is 86400 (1 day).
# Set 0 to disable idle logout. Session files are kept 24h (SESSION_RETENTION_MIN in entrypoint).
# ADMIN_SESSION_IDLE_SECONDS=86400

# --- Logging ---
# Set to DEBUG for verbose ManticoreSearch query logging
# LOG_LEVEL=DEBUG
