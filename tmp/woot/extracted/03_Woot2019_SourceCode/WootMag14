	cp e
	jr z,wspc	;if at the start of a line don't print a space
	ld a,(hl)
	jr wentry	;miss out first cp ' '
wwlp:	ld a,(hl)
	cp ' '		;space means end of word, ww complete
	jr z,wout
	cp '.'		;full stop means end of word, ww complete
	jr z,wout
	cp ','
	jr z,wout	;ditto
